#!/usr/bin/env bash
# Bash Strict Mode: http://redsymbol.net/articles/unofficial-bash-strict-mode/
set -euo pipefail
IFS=$'\n\t'
# Bash Strict Mode

# Root install runs this before `brew bundle`, so python/Brewfile's `uv` isn't
# on PATH yet on a fresh machine; the official installer works on both macOS
# and Linux and is a no-op once brew's uv takes over.
if ! command_exists uv; then
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="$HOME/.local/bin:$PATH"
fi

uv python install 3.13
