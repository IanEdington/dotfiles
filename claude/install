#!/usr/bin/env bash
# Bash Strict Mode: http://redsymbol.net/articles/unofficial-bash-strict-mode/
set -euo pipefail
IFS=$'\n\t'
# Bash Strict Mode

# ~/.claude is a symlink to this directory, so local edits to settings.json /
# CLAUDE.md are live immediately and runtime state is kept out of git by the
# .gitignore here.
dotfiles::symlink_files ~/.dotfiles/claude ~/.claude

# Claude Code reads user-scoped MCP servers from ~/.claude.json (via
# `claude mcp add`), not from settings.json.
if command_exists claude && ! claude mcp get playwright &> /dev/null; then
    claude mcp add --scope user playwright -- npx -y @playwright/mcp@latest
fi


# Skills from the private personal-assistant repo (not part of dotfiles).
# Symlink them in when a local clone exists; ~/.claude/skills is inside this
# repo's working copy, so the symlink targets are gitignored (see .gitignore).
for pa_dir in "$HOME/dev/personal-assistant" "$HOME/personal-assistant"; do
    if [ -d "$pa_dir/skills" ]; then
        for skill in "$pa_dir"/skills/*/; do
            ln -sfn "${skill%/}" ~/.claude/skills/"$(basename "$skill")"
        done
        break
    fi
done
