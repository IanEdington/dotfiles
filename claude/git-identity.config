# Git author identity for Claude Code cloud sessions.
#
# Cloud sessions start with user.name = Claude / user.email =
# noreply@anthropic.com. The SessionStart hook in settings.json points the
# harness gitconfig at this file, which is included *after* that [user]
# section and therefore wins.
#
# The default below is the personal identity. Per-repo overrides are keyed on
# the remote URL rather than the checkout path, because cloud checkout paths
# are not stable across sessions but the remote always is on a fresh clone.
#
# THIS REPO IS PUBLIC. Do not add work email addresses or employer org names
# here. Put those in git-identity.local.config, which is untracked (the
# .gitignore whitelist keeps it out) and written per environment by the setup
# script. See readme.md, "Per-repo identities in cloud".

[user]
	name = Ian Edington
	email = ian.edington@gmail.com

# Optional, untracked, may not exist: git silently skips a missing include.
#
# Each override in that file takes two includeIf blocks pointing at the same
# path, because no single pattern matches every remote URL form:
#
#   [includeIf "hasconfig:remote.*.url:**/ORG/**"]   # https:// and ssh:// forms
#   	path = ~/.claude/git-identity.ORG.config
#   [includeIf "hasconfig:remote.*.url:*ORG/**"]     # git@host:ORG/repo form
#   	path = ~/.claude/git-identity.ORG.config
#
# Match on the org path only. In cloud, remote.origin.url is not github.com at
# all: the harness rewrites it to a session proxy such as
# http://local_proxy@127.0.0.1:41729/git/ORG/REPO, and that port changes every
# session. The /ORG/REPO tail is the only stable part, so a pattern containing
# a host or port will silently never match and commits keep the default email.
[include]
	path = ~/.claude/git-identity.local.config
