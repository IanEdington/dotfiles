# Git author identity for Claude Code cloud sessions. Included by the
# SessionStart hook in settings.json; see readme.md for why it is a hook.

[user]
	name = Ian Edington
	email = ian.edington@gmail.com

# Per-repo overrides. Optional and untracked; git skips a missing include.
# THIS REPO IS PUBLIC: work emails and org names go in the override file,
# written by the environment's private setup-script field, never here.
#
#   cat > ~/.claude/git-identity.local.config <<'EOF'
#   [includeIf "hasconfig:remote.*.url:**/ORG/**"]
#   	path = ~/.claude/git-identity.ORG.config
#   [includeIf "hasconfig:remote.*.url:*ORG/**"]
#   	path = ~/.claude/git-identity.ORG.config
#   EOF
#
# Both patterns are required: **/ORG/** matches https:// and ssh:// remotes,
# *ORG/** matches git@host:ORG/repo. Match the org path only — in cloud,
# remote.origin.url is a session proxy (http://local_proxy@127.0.0.1:PORT/
# git/ORG/REPO) whose port changes per session, so any pattern naming a host
# or port silently never matches and commits keep the default email.
#
# Failures here are quiet: a non-matching pattern yields a wrong author, not
# an error. Verify with `git config user.email` in a repo of that org.
[include]
	path = ~/.claude/git-identity.local.config
