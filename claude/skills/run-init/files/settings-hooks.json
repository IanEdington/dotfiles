{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit|mcp__.*__(merge_pull_request|enable_pr_auto_merge|create_pull_request|update_pull_request|create_or_update_file|push_files|delete_file|create_branch|add_issue_comment|issue_write|sub_issue_write|update_issue_comment)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-guard.mjs\" pre-tool",
            "timeout": 600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-guard.mjs\" stop",
            "timeout": 30
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-guard.mjs\" permission",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
