{#- Managed by dotfiles/claude-box (sandbox role). Rendered to
    /etc/claude-code/managed-settings.d/, root-owned. -#}
{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.config/github-tokens/**)"
    ],
{#- A matching ask rule prompts even when a hook allows, so ssh is left to
    the hook, which asks for everything it doesn't allow. #}
    "ask": {{ sandbox_remote_shell_commands | reject('equalto', 'ssh *') | map('regex_replace', '^(.*)$', 'Bash(\\1)') | list | to_json }}
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": {{ (['/usr/bin/python3', '-I', sandbox_hook_dir ~ '/ssh_trusted_hosts.py'] + sandbox_trusted_ssh_hosts) | map('quote') | join(' ') | to_json }},
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": {{ (not box_setup_phase) | to_json }},
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": {{ (sandbox_remote_shell_commands + sandbox_github_commands) | to_json }},
    "network": {
      "allowedDomains": {{ sandbox_allowed_domains | to_json }}
    },
    "credentials": {
      "files": [
        { "path": "{{ box_home }}/.ssh", "mode": "deny" },
        { "path": "{{ box_home }}/.config/github-tokens", "mode": "deny" },
        { "path": "{{ box_home }}/.cache/ms-playwright", "mode": "deny" }
      ]
    }
  }
}
