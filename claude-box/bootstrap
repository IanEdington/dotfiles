#!/usr/bin/env bash
# Bash Strict Mode: http://redsymbol.net/articles/unofficial-bash-strict-mode/
set -euo pipefail
IFS=$'\n\t'
# Bash Strict Mode

# Bring an Ubuntu server to the state in playbook.yml. Safe to rerun; extra
# arguments go to ansible-playbook, e.g. `--check --diff` or `--tags claude`.
# Not named `install`: the root install runs every */install on laptops.
#
# Usage: bash ~/code/dotfiles/claude-box/bootstrap [ansible-playbook args]
#   BOX_USER=claude  user whose environment is configured (default: you)

BOX_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd -P )"

# After the lockdown only the admin can become root; say so plainly instead of
# letting Ansible fail with "sudo: a password is required".
if [ "$(id -u)" -ne 0 ] && ! id -nG "$(id -un)" | tr ' ' '\n' | grep -qx sudo; then
    echo "$(id -un) can't use sudo. Run this as the admin, from the admin's clone:" >&2
    echo "  BOX_USER=$(id -un) bash ~<admin>/code/dotfiles/claude-box/bootstrap" >&2
    exit 1
fi

# Ansible can't recognize sudo-rs's password prompt (Ubuntu 26.04's sudo) and
# times out, so take root once here and every become starts as root.
if [ "$(id -u)" -ne 0 ]; then
    exec sudo env HOME=/root BOX_USER="${BOX_USER:-$(id -un)}" \
        bash "$BOX_DIR/bootstrap" "$@"
fi

if ! command -v ansible-playbook > /dev/null; then
    sudo apt-get update -q
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -q ansible
fi

export ANSIBLE_CONFIG="$BOX_DIR/ansible.cfg"
exec ansible-playbook -i localhost, "$BOX_DIR/playbook.yml" \
    -e "box_user=${BOX_USER:-$(id -un)}" "$@"
