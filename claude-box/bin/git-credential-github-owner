#!/usr/bin/env bash
set -euo pipefail

# git credential helper: answer with the fine-grained PAT for the repo's owner.
# Fine-grained tokens belong to exactly one owner (a user or one org), so the
# box keeps one token per owner in ~/.config/github-tokens/<owner>, mode 0600.
# Needs credential.useHttpPath so git passes the repo path (owner/repo.git).

TOKEN_DIR="${GITHUB_TOKEN_DIR:-$HOME/.config/github-tokens}"

[ "${1:-}" = get ] || exit 0

host='' path=''
while IFS='=' read -r key value; do
    [ -n "$key" ] || break
    case "$key" in
        host) host=$value ;;
        path) path=$value ;;
    esac
done

[ "$host" = github.com ] || exit 0
owner=${path%%/*}
[ -n "$owner" ] || exit 0

# GitHub owners are case-insensitive; token files are named in lowercase.
token_file="$TOKEN_DIR/${owner,,}"
[ -r "$token_file" ] || exit 0

echo "username=x-access-token"
echo "password=$(head -n1 "$token_file")"
