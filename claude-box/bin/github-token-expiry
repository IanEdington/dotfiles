#!/usr/bin/env bash
set -euo pipefail

# Print when each stored GitHub token expires, without printing the token.
# The token reaches curl through a config on stdin, not the command line, so
# it never shows in the process list. Run as the box user.
# Usage: github-token-expiry

TOKEN_DIR="${GITHUB_TOKEN_DIR:-$HOME/.config/github-tokens}"

for file in "$TOKEN_DIR"/*; do
    owner=$(basename "$file")
    # `default` links to one of the others.
    [ -L "$file" ] && continue
    headers=$(printf 'header = "Authorization: Bearer %s"\n' "$(head -n1 "$file")" |
        curl --silent --config - --output /dev/null --dump-header - https://api.github.com/user)
    status=$(awk 'NR==1 {print $2}' <<< "$headers")
    expiry=$(awk -F': ' 'tolower($1)=="github-authentication-token-expiration" {print $2}' <<< "$headers" | tr -d '\r')
    if [ "$status" = 200 ]; then
        printf '%-16s expires %s\n' "$owner" "${expiry:-never}"
    else
        printf '%-16s rejected by GitHub (HTTP %s): expired or revoked\n' "$owner" "$status"
    fi
done
