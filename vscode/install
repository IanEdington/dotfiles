#!/usr/bin/env bash
# Bash Strict Mode: http://redsymbol.net/articles/unofficial-bash-strict-mode/
set -euo pipefail
IFS=$'\n\t'
# Bash Strict Mode

source ~/.dotfiles/shells/bash_utils.sh

if is_darwin; then
    VSCODE_USER_DIR="$HOME/Library/Application Support/Code/User"
    dotfiles::symlink_files "$HOME/.dotfiles/vscode/settings.json" "$VSCODE_USER_DIR/settings.json"
    dotfiles::symlink_files "$HOME/.dotfiles/vscode/macos-keybindings.json" "$VSCODE_USER_DIR/keybindings.json"
    dotfiles::symlink_files "$HOME/.dotfiles/vscode/snippets" "$VSCODE_USER_DIR/snippets"
else
    VSCODE_USER_DIR="$HOME/.config/Code/User"
    dotfiles::symlink_files "$HOME/.dotfiles/vscode/settings.json" "$VSCODE_USER_DIR/settings.json"
    dotfiles::symlink_files "$HOME/.dotfiles/vscode/linux-keybindings.json" "$VSCODE_USER_DIR/keybindings.json"
    dotfiles::symlink_files "$HOME/.dotfiles/vscode/snippets" "$VSCODE_USER_DIR/snippets"
fi

if command_exists code; then
    while IFS= read -r extension; do
        # `code --install-extension` narrates every already-installed extension by
        # default; only surface it when the install actually fails.
        if ! code --install-extension "$extension" &> /dev/null; then
            echo_yellow "-[ ] VSCODE: failed to install extension '$extension'"
        fi
    done < "$HOME/.dotfiles/vscode/extensions.txt"
else
    echo_yellow "-[ ] VSCODE: 'code' not on PATH, skipping extension install"
fi
