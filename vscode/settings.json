{
  "window.title": "${rootName}",
  "editor.lineNumbers": "relative",
  "editor.fontSize": 20,
  "editor.fontFamily": "Jetbrains Mono,OperatorMono Nerd Font, Menlo, Monaco, 'Courier New', monospace",
  "editor.minimap.enabled": false,
  "vim.leader": ";",
  "vim.easymotion": true,
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": [
        "[",
        "c"
      ],
      "commands": [
        {
          "command": "workbench.action.editor.previousChange"
        }
      ]
    },
    {
      "before": [
        "]",
        "c"
      ],
      "commands": [
        {
          "command": "workbench.action.editor.nextChange"
        }
      ]
    },
    {
      "before": [
        "[",
        "p"
      ],
      "commands": [
        {
          "command": "editor.action.marker.prev"
        }
      ]
    },
    {
      "before": [
        "]",
        "p"
      ],
      "commands": [
        {
          "command": "editor.action.marker.next"
        }
      ]
    },
    {
      "before": [
        "g",
        "w",
        "h"
      ],
      "commands": [
        {
          "command": "workbench.action.focusPreviousGroup"
        }
      ]
    },
    {
      "before": [
        "g",
        "w",
        "l"
      ],
      "commands": [
        {
          "command": "workbench.action.focusNextGroup"
        }
      ]
    },
    {
      // git-gutter hunk undo
      "before": ["<leader>", "h", "u"],
      "commands": [{ "command": "git.revertSelectedRanges" }]
    },
    {
      "before": [
        "c",
        "o",
        "w"
      ],
      "commands": [
        {
          "command": "editor.action.toggleWordWrap"
        }
      ]
    },
    {
      "before": [
        "c",
        "o",
        "h"
      ],
      "commands": [
        {
          "command": ":nohl"
        }
      ]
    },
    {
      "before": [
        "<leader>", "f", "m"
      ],
      "commands": [
        {
          "command": "editor.action.formatDocument",
        }
      ]
    },
    {
      "before": ["<leader>", "x"],
      "after": ["\"", "+", "Y", "d", "d"]
    },
    {
      "before": ["<leader>", "c"],
      "after": ["\"", "+", "Y"]
    },
    {
      "before": ["<leader>", "v"],
      "after": ["\"", "+", "]", "p"]
    },
    {
      "before": ["<leader>", "V"],
      "after": ["\"", "+", "]", "P"]
    }
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    {
      "before": ["<leader>", "x"],
      "after": ["\"", "+", "y", "g", "v", "d"]
    },
    {
      "before": ["<leader>", "c"],
      "after": ["\"", "+", "y"]
    },
    {
      "before": ["<leader>", "v"],
      "after": ["d", "\"", "+", "]", "p"]
    },
    {
      "before": ["<leader>", "V"],
      "after": ["d", "\"", "+", "]", "P"]
    }
  ],
  "vim.insertModeKeyBindingsNonRecursive": [
    {
      "before": ["<leader>", "x"],
      "after": ["<esc>", "\"", "+", "Y", "d", "d", "i"]
    },
    {
      "before": ["<leader>", "c"],
      "after": ["<esc>", "\"", "+", "Y", "a"]
    },
    {
      "before": ["<leader>", "v"],
      "after": ["<esc>", "\"", "+", "]", "p", "a"]
    },
    {
      "before": ["<leader>", "V"],
      "after": ["<esc>", "\"", "+", "]", "P", "a"]
    }
  ],
  "explorer.confirmDelete": false,
  "jest.autoEnable": false,
  "editor.codeActionsOnSave": {},
  "auto-close-tag.fullMode": true,
  "editor.guides.indentation": false,
  "terminal.external.linuxExec": "xterm-256color",
  "terminal.integrated.copyOnSelection": true,
  "workbench.colorTheme": "Solarized Dark",
  "accessibility.signals.terminalBell": {
    "sound": "on"
  },
  "terminal.integrated.enableVisualBell": true,
  "files.autoSave": "afterDelay",
  "chat.experimental.implicitContext": true,
  "terminal.integrated.defaultProfile.linux": "zsh",
  "php.suggest.basic": true,
  "php.validate.enable": true,
  "openInGitHub.alwaysUseDefaultBranch": true,
  "githubPullRequests.pullBranch": "never",
  "editor.accessibilitySupport": "off",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[sql]": {
   "editor.defaultFormatter": "ReneSaarsoo.sql-formatter-vsc",
   "editor.formatOnSave": true
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit",
      "source.fixAll.ruff": "explicit"
    }
  },
  "python.analysis.typeCheckingMode": "basic",
  "SQL-Formatter-VSCode.dialect": "postgresql",
  "SQL-Formatter-VSCode.keywordCase": "upper",
  "SQL-Formatter-VSCode.functionCase": "upper",
  "SQL-Formatter-VSCode.dataTypeCase": "upper",
  "SQL-Formatter-VSCode.ignoreTabSettings": true,
  "SQL-Formatter-VSCode.tabSizeOverride": 4,
  "git.blame.editorDecoration.enabled": true,
  "cursor.cpp.disabledLanguages": [
    "plaintext",
    "markdown",
    "scminput"
  ],
  "cursor.composer.textSizeScale": 1.15,
  "dotfiles.repository": "https://github.com/IanEdington/dotfiles.git",
  "dotfiles.targetPath": "~/.dotfiles",
  "docker.extension.enableComposeLanguageServer": false,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "window.commandCenter": true,
  "terminal.integrated.persistentSessionScrollback": 1000,
  "terminal.integrated.scrollback": 10000,
  "workbench.activityBar.orientation": "vertical",
  "vs-kubernetes": {
    "vscode-kubernetes.minikube-path-mac": "/Users/ian/.vs-kubernetes/tools/minikube/darwin-arm64/minikube",
    "vs-kubernetes.crd-code-completion": "disabled"
  },
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[php]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "cursor.composer.queueMessageDefaultBehavior": "queue",
  "terraform.mcp.server.enable": true,
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "application.shellEnvironmentResolutionTimeout": 30,
  "cursor.composer.usageSummaryDisplay": "always",
  "workbench.statusBar.visible": false,
  "yaml.schemas": {
    "file:///Users/ian/.vscode/extensions/continue.continue-1.2.14-darwin-arm64/config-yaml-schema.json": [
      ".continue/**/*.yaml"
    ]
  },
  "remote.defaultExtensionsIfInstalledLocally": [
    "GitHub.vscode-pull-request-github"
  ],
  "claudeCode.preferredLocation": "panel",
  "claudeCode.allowDangerouslySkipPermissions": true,
  "chat.tools.terminal.autoApprove": {
    "ddev": true
  },
  "security.promptForLocalFileProtocolHandling": false,
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
}
