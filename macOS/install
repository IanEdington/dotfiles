#!/usr/bin/env bash
# Bash Strict Mode: http://redsymbol.net/articles/unofficial-bash-strict-mode/
set -euo pipefail
IFS=$'\n\t'
# Bash Strict Mode

source ~/.dotfiles/shells/bash_utils.sh

if ! is_darwin ; then
    return
fi
if ! command_exists brew ; then
    echo_red "Error: homebrew is a prerequisite for this script. Install from brew.sh"
    exit 1
fi

# Install Brew programs
echo_yellow "-[ ] run \`update_brew\`"

# add brew's zsh and bash to the "acceptable shells" file
bash_count=$(cat /etc/shells | grep -c "$(brew --prefix)/bin/bash" || true)
if [[ $bash_count < 1 ]] ; then
    echo "$(brew --prefix)/bin/bash" | sudo tee -a /etc/shells > /dev/null
fi
zsh_count=$(cat /etc/shells | grep -c "$(brew --prefix)/bin/zsh" || true)
if [[ $zsh_count < 1 ]] ; then
    echo "$(brew --prefix)/bin/zsh" | sudo tee -a /etc/shells > /dev/null
fi

echo_yellow "-[ ] install dropbox"
echo_yellow "-[ ] install 1Password"
echo_yellow "-[ ] install jetbrains mono https://www.jetbrains.com/lp/mono/"

# Xcode
# full xcode installation is required
# Test each command directly. Reading `$?` after a preceding `if` returns that
# statement's status, not the command's, so the command line tools branch used
# to fire on every run: an unwanted install popup and a sudo password prompt.
if ! xcodebuild -version &> /dev/null ; then
    echo_yellow "-[ ] TODO you need to install xcode from the app store"
fi
# so is xcode command line tools
if ! xcode-select -version &> /dev/null ; then
    xcode-select --install
    sudo xcodebuild -license accept
fi

dotfiles::symlink_files ~/.dotfiles/macOS/karabiner.json ~/.config/karabiner/karabiner.json

source ./terminfo/install

dotfiles::symlink_files ~/.dotfiles/macOS/yabairc ~/.config/yabai/yabairc
yabai --start-service || echo_red "Warning: yabai --start-service failed; run macOS/yabai/doctor.sh"

# yabai scripting-addition loader (LaunchDaemon)
SCRIPT_SRC=~/.dotfiles/macOS/yabai/yabai-load-sa.sh
SCRIPT_DST=/usr/local/libexec/yabai-load-sa
PLIST_SRC=~/.dotfiles/macOS/yabai/com.ianedington.yabai.plist
PLIST_DST=/Library/LaunchDaemons/com.ianedington.yabai.plist
LABEL=com.ianedington.yabai

# Always overwrite: installing only when missing meant edits to the repo copy
# never reached the running daemon.
# Both destinations are world-readable (755 and 644), so comparing them needs
# no privileges. Only escalate for the writes that actually require it.
changed=0
if [ -f "$SCRIPT_SRC" ] && ! cmp -s "$SCRIPT_SRC" "$SCRIPT_DST" ; then
    sudo install -d -m 0755 -o root -g wheel /usr/local/libexec
    sudo install -m 0755 -o root -g wheel "$SCRIPT_SRC" "$SCRIPT_DST"
    changed=1
fi

if [ -f "$PLIST_SRC" ] && ! cmp -s "$PLIST_SRC" "$PLIST_DST" ; then
    sudo install -m 0644 -o root -g wheel "$PLIST_SRC" "$PLIST_DST"
    changed=1
fi

# `launchctl print system/...` needs root just to answer, so use the daemon's
# own process as the unprivileged liveness check instead.
if [ -f "$PLIST_DST" ]; then
    if ! pgrep -f "$SCRIPT_DST" > /dev/null 2>&1; then
        sudo launchctl bootstrap system "$PLIST_DST" 2> /dev/null || true
        sudo launchctl enable system/$LABEL
        sudo launchctl kickstart -k system/$LABEL
    elif [[ $changed == 1 ]]; then
        sudo launchctl kickstart -k system/$LABEL
    fi
fi

# dark-notify LaunchAgent: keeps vim/zsh's light-dark state file (bin/theme-sync)
# in sync with the system Appearance setting. Per-user agent, so no sudo needed.
if command_exists dark-notify ; then
    AGENT_LABEL=com.ianedington.dark-notify
    AGENT_DST=~/Library/LaunchAgents/$AGENT_LABEL.plist
    mkdir -p ~/Library/LaunchAgents
    sed \
        -e "s#__DARK_NOTIFY_BIN__#$(command -v dark-notify)#" \
        -e "s#__THEME_SYNC_BIN__#$HOME/.dotfiles/bin/theme-sync#" \
        ~/.dotfiles/macOS/theme/com.ianedington.dark-notify.plist > "$AGENT_DST.tmp"
    if ! cmp -s "$AGENT_DST.tmp" "$AGENT_DST" 2> /dev/null ; then
        mv "$AGENT_DST.tmp" "$AGENT_DST"
        launchctl bootout "gui/$(id -u)/$AGENT_LABEL" 2> /dev/null || true
        launchctl bootstrap "gui/$(id -u)" "$AGENT_DST"
    else
        rm -f "$AGENT_DST.tmp"
    fi
else
    echo_yellow "-[ ] dark-notify not installed; run update_brew then re-run macOS/install to enable auto light/dark theme sync"
fi

# The sudoers entry pins a SHA256 of the yabai binary, so it must be
# regenerated after every `brew upgrade yabai`. The file itself is 0440 root,
# so record the hash we last wrote somewhere readable and only escalate when it
# actually changes; otherwise every run would prompt for a password.
if command_exists yabai ; then
    yabai_path=$(command -v yabai)
    yabai_hash=$(shasum -a 256 "$yabai_path" | cut -d' ' -f1)
    stamp=~/.local/share/dotfiles/yabai-sudoers-hash
    if [ "$(cat "$stamp" 2> /dev/null || true)" != "$yabai_hash" ] ; then
        sudoers_line="$(whoami) ALL=(root) NOPASSWD: sha256:$yabai_hash $yabai_path --load-sa"
        echo "$sudoers_line" | sudo tee /private/etc/sudoers.d/yabai > /dev/null
        sudo chmod 0440 /private/etc/sudoers.d/yabai
        mkdir -p "$(dirname "$stamp")"
        echo "$yabai_hash" > "$stamp"
    fi
fi

