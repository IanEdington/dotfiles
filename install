#!/usr/bin/env bash
# Bash Strict Mode: http://redsymbol.net/articles/unofficial-bash-strict-mode/
set -euo pipefail
IFS=$'\n\t'
# Bash Strict Mode

# TODO: take a parameter to limit the number of packages to install. This is useful for debugging.
# TODO: take a flag called --debug to print out logs of what is happening.

# ref: http://stackoverflow.com/a/246128/4301584
DOTFILES_ROOT="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd -P )"

source "$DOTFILES_ROOT/shells/bash_utils.sh"
source "$DOTFILES_ROOT/shells/env.sh"

# Symlink the current folder to .dotfiles
dotfiles::symlink_files $DOTFILES_ROOT $HOME/.dotfiles;
cd $HOME/.dotfiles
log "dotfiles root $DOTFILES_ROOT"

# Starting the fun stuff
# ----------------------

# Ask for the administrator password upfront
if command_exists sudo; then
    sudo -v
    # Keep-alive: refresh the sudo timestamp until this script exits.
    # `|| true` matters: the subshell inherits `set -e`, so a single transient
    # failure here would kill the keep-alive for the rest of the run and the
    # next sudo call would prompt for a password again.
    while true; do
        sudo -n true || true;
        sleep 60;
        kill -0 "$$" 2>/dev/null || exit;
    done 2>/dev/null &
fi

# Make sure expected folders exist
mkdir $HOME/.local &> /dev/null || true
mkdir $HOME/.local/bin &> /dev/null || true

# Install python early
echo "Installing python"
source ./python/install

# Homebrew refuses to load formulae from third-party taps until they are
# explicitly trusted, and `brew bundle` cannot express that. Keep this an
# explicit list rather than trusting whatever a Brewfile happens to tap.
TRUSTED_TAPS=(asmvik/formulae)
if is_darwin && command_exists brew ; then
    for trusted_tap in "${TRUSTED_TAPS[@]}" ; do
        brew tap "$trusted_tap" > /dev/null 2>&1 || true
        brew trust "$trusted_tap" > /dev/null 2>&1 \
            || echo_red "Warning: could not trust $trusted_tap; its formulae will fail to install"
    done
fi

if is_darwin && [ -f Brewfile ]; then
    brew bundle
fi

# Install Scripts
# Run install scripts for each folder in dotfiles/
for dir in */ ; do
    log Installing the $dir directory:
    cd $dir;
    echo "Installing $dir"

    if is_darwin && [ -f Brewfile ]; then
        brew bundle
    fi
    if [ -f install ]; then
        source ./install
    fi

    log Finished $dir directory:
    cd $HOME/.dotfiles
done

echo_green "done"
